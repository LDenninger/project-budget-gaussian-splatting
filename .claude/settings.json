{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Research explanations",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PROJECT_ROOT:-$PWD}/.claude/hooks/startup.py\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${PROJECT_ROOT:-.}/.claude/statusline.sh\""
  }
}
